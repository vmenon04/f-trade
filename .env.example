# Copy to .env next to docker-compose.yml on the Linux machine and fill in every value. .env is gitignored.

# the Linux machine's private IP: Kafka and Postgres are published on it, and Kafka tells clients to connect to it
HOST_IP=

# the database, user and password the app connects with (spring.datasource.* in application.properties)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=8082

# the port the trade API (the api service) is published on; only 8080-8100 are reachable from the VM
API_PORT=8081

# market data, used by the validation and execution services: the simulated service (market-sim) by default. Its prices
# are made up. Any long random value works as the key, since compose gives both sides the same one.
MARKET_DATA_BASE_URL=http://market-sim:8090/v1
MARKET_DATA_API_KEY=
# how long a price stays cached in Redis before market data is asked again
MARKET_DATA_CACHE_TTL=30s
# market data calls allowed a day: market-sim has no quota, so this is high (Fauxnance's key allowed 2000)
MARKET_DATA_DAILY_LIMIT=1000000

# Redis, the price cache. Published on HOST_IP:REDIS_PORT (8080-8100 are reachable from the VM)
REDIS_PORT=8083
REDIS_PASSWORD=

# secret login tokens are signed (auth-service) and checked (the app) with, at least 32 characters
JWT_SHARED_SECRET=

# the port auth-service (login, registration, token refresh) is published on
AUTH_PORT=8084

# web UIs for Redis, Kafka and Postgres, only started with `docker compose --profile tools up -d`. The web UIs sit
# together from 8085 (SonarQube) up
REDIS_INSIGHT_PORT=8086
KAFKA_UI_PORT=8087
ADMINER_PORT=8088
# the port the web app (platform-ui, served by nginx) is published on
UI_PORT=8089

# logo.dev's publishable (pk_) key for company and coin logos; optional, logos fall back to the ticker's first letter
LOGO_DEV_CRED_KEY=

# Finnhub key for the market news on the dashboard and trade page; optional, without it there is no news
FINNHUB_API_KEY=

# only for docker-compose.prod.yml (one public server): the name the web app is served at over HTTPS, e.g.
# f-trade.duckdns.org. HOST_IP is 127.0.0.1 there.
SITE_DOMAIN=

# only for docker-compose.ci.yml (Jenkins and SonarQube on the public server)
# the server's docker group: `getent group docker | cut -d: -f3`
DOCKER_GID=
# the Jenkins login that can change things; everyone else can only look
JENKINS_ADMIN_USER=
JENKINS_ADMIN_PASSWORD=
# a GitHub token for this repo only (fine-grained: Contents read, Commit statuses read and write, Pull requests read),
# for Jenkins to read the branches and report each build on its commit
JENKINS_GITHUB_TOKEN=
# password of SonarQube's own database; any long random value
SONAR_DB_PASSWORD=
# made in SonarQube once it is up (My Account -> Security, a global analysis token); Jenkins analyses with it
SONAR_TOKEN=
