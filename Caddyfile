# Used by docker-compose.prod.yml: HTTPS for the web app at SITE_DOMAIN (from .env), with http:// redirected to it.
# The frontend's nginx forwards /v1, /auth and /api to the services behind it.
{$SITE_DOMAIN} {
	encode gzip
	reverse_proxy frontend:80
}

# The same web app under a second name, where it shows its plain HTML version: the app looks at the name it was
# opened with (platform-ui's PlainStyleService).
retro.{$SITE_DOMAIN} {
	encode gzip
	reverse_proxy frontend:80
}

# Jenkins and SonarQube (docker-compose.ci.yml), each under its own name. Any name ending in SITE_DOMAIN leads to this
# server when it is a duckdns.org name. Until they are started, these two just answer 502.
jenkins.{$SITE_DOMAIN} {
	reverse_proxy jenkins:8080
}

sonar.{$SITE_DOMAIN} {
	reverse_proxy sonarqube:9000
}
